{
  "manifest_version": 3,
  "name": "PastePic",
  "version": "1.3.1",
  "description": "Cole imagens do clipboard (Cmd+V / Ctrl+V) em editores web: faz upload automático para um host gratuito e insere a tag <img> ou Markdown no cursor.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://catbox.moe/*",
    "https://litterbox.catbox.moe/*",
    "https://pomf.lain.la/*",
    "https://pomf2.lain.la/*",
    "https://uguu.se/*",
    "https://n.uguu.se/*",
    "https://tmpfiles.org/*",
    "https://api.imgur.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tabnews.com.br/*",
        "https://tabnews.com.br/*",
        "https://curso.dev/*",
        "https://www.curso.dev/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tabnews.com.br/*",
        "https://tabnews.com.br/*",
        "https://curso.dev/*",
        "https://www.curso.dev/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PastePic"
  }
}
