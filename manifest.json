{
  "manifest_version": 3,
  "name": "PastePic",
  "version": "2.0.0",
  "homepage_url": "https://github.com/fm1randa/pastepic",
  "description": "Cole imagens do clipboard (Cmd+V / Ctrl+V) em editores web: faz upload automático para um host gratuito e insere a tag <img> ou Markdown no cursor.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://catbox.moe/*",
    "https://litterbox.catbox.moe/*",
    "https://pomf.lain.la/*",
    "https://uguu.se/*",
    "https://tmpfiles.org/*",
    "https://api.imgur.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tabnews.com.br/*",
        "https://tabnews.com.br/*",
        "https://curso.dev/*",
        "https://www.curso.dev/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tabnews.com.br/*",
        "https://tabnews.com.br/*",
        "https://curso.dev/*",
        "https://www.curso.dev/*"
      ],
      "js": ["limits.js", "editor-session.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PastePic",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
